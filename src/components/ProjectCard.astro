---
import type { Project } from '../data/projects';

type Props = Project;

const { title, description, link, status, released, images = [], tags = [] } = Astro.props;
const isExternalLink = Boolean(link);
---

<a
  href={link ?? '#'}
  target={isExternalLink ? '_blank' : undefined}
  rel={isExternalLink ? 'noopener noreferrer' : undefined}
  class="group block bg-white/10 backdrop-blur-lg rounded-xl p-6 hover:bg-white/20 transition-all duration-300 border border-white/20 hover:border-purple-400/50 hover:shadow-2xl hover:shadow-purple-500/20 hover:-translate-y-1"
>
  <div class="flex items-start justify-between mb-3">
    <h3 class="text-xl font-bold text-cyan-400 group-hover:text-cyan-300 transition-colors">
      {title}
    </h3>
    {status && (
      <span class="px-3 py-1 text-xs font-semibold rounded-full bg-purple-500/30 text-purple-200 border border-purple-400/30">
        {status}
      </span>
    )}
  </div>

  {description && (
    <p class="text-gray-300 mb-4 text-sm">{description}</p>
  )}

  {images.length > 0 && (
    <div class="grid grid-cols-2 gap-2 mb-4 rounded-lg overflow-hidden">
      {images.map((image) => (
        <img
          src={image}
          alt={title}
          class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      ))}
    </div>
  )}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="px-2 py-1 text-xs bg-cyan-500/20 text-cyan-300 rounded border border-cyan-400/30">
          {tag}
        </span>
      ))}
    </div>
  )}

  {isExternalLink && (
    <div class="mt-4 flex items-center text-sm text-purple-300 group-hover:text-purple-200 transition-colors">
      {released ? 'View on Website' : 'View on GitHub'}
      <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  )}
</a>
