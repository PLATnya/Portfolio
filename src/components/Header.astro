---
const baseUrl = import.meta.env.BASE_URL;
---

<header class="container mx-auto px-4 py-8">
  <div class="text-center space-y-4">
    <h1 class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 bg-clip-text text-transparent animate-gradient bg-[length:200%_auto]">
      Vadym Platanyi
    </h1>
    <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Hi, my name is <span class="text-cyan-400 font-semibold">Vadym</span>
      I'm a Game Developer, Software Engineer and AI Engineer.
      Now I'm working on different AI and Data research related projects and a cooperative horror game called "Fear Of Faith".
    </p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-6">
      <a 
        href={`${baseUrl}/resume.pdf`}
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-cyan-500/20 to-purple-500/20 hover:from-cyan-500/30 hover:to-purple-500/30 border border-cyan-400/50 hover:border-purple-400/70 rounded-lg text-cyan-300 hover:text-purple-200 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/30 hover:-translate-y-1"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span class="font-semibold">View Resume</span>
      </a>
      <div class="flex flex-col items-center">
        <a 
          href="https://www.kaggle.com/vadimplataniy"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-cyan-500/20 to-purple-500/20 hover:from-cyan-500/30 hover:to-purple-500/30 border border-cyan-400/50 hover:border-purple-400/70 rounded-lg text-cyan-300 hover:text-purple-200 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/30 hover:-translate-y-1"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="font-semibold">Kaggle</span>
        </a>
        <p class="text-xs text-gray-400 mt-1 text-center">There's not much there,</p>
        <p class="text-xs text-gray-400 mt-1 text-center">but at least there's something.</p>
      </div>
    </div>
  </div>
</header>

