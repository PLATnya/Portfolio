---
import LinkButton from './LinkButton.astro';
import { site } from '../data/site';

const baseUrl = import.meta.env.BASE_URL;
const resumeHref = `${baseUrl}${site.resumePath}`;
const resumeIcon = 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z';
const boltIcon = 'M13 10V3L4 14h7v7l9-11h-7z';
---

<header class="container mx-auto px-4 py-8">
  <div class="text-center space-y-4">
    <h1 class="text-5xl md:text-6xl font-bold text-slate-900">
      Vadym Platanyi
    </h1>
    <p class="text-lg md:text-xl text-slate-800 max-w-2xl mx-auto leading-relaxed" set:html={site.taglineHtml} />
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-6">
      <LinkButton href={resumeHref} label="View Resume" iconPath={resumeIcon} external />
      {site.socials.map((social) => (
        <div class="flex flex-col items-center">
          <LinkButton href={social.href} label={social.label} iconPath={boltIcon} />
          <p class="text-xs text-slate-600 mt-1 text-center">There's not much there,</p>
          <p class="text-xs text-slate-600 mt-1 text-center">but at least there's something.</p>
        </div>
      ))}
    </div>
  </div>
</header>
