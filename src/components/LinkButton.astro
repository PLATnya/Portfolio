---
interface Props {
  href: string;
  label: string;
  iconPath: string;
  external?: boolean;
}

const { href, label, iconPath, external } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(href);
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 border border-slate-700 rounded-lg text-slate-100 hover:bg-slate-800 hover:text-white transition-all duration-300 hover:-translate-y-1"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath}></path>
  </svg>
  <span class="font-semibold">{label}</span>
</a>
