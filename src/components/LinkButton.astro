---
interface Props {
  href: string;
  label: string;
  iconPath: string;
  external?: boolean;
}

const { href, label, iconPath, external } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(href);
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-cyan-500/20 to-purple-500/20 hover:from-cyan-500/30 hover:to-purple-500/30 border border-cyan-400/50 hover:border-purple-400/70 rounded-lg text-cyan-300 hover:text-purple-200 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/30 hover:-translate-y-1"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath}></path>
  </svg>
  <span class="font-semibold">{label}</span>
</a>
